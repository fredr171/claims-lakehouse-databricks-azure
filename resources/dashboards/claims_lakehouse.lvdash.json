{
  "datasets": [
    {
      "name": "pmpm",
      "displayName": "PMPM by payer and month",
      "queryLines": [
        "-- Net paid per member month (PMPM), by payer and service month.\n",
        "-- A member month is a member covered on any day of the month; net paid is by service month.\n",
        "SELECT\n",
        "    payer_id,\n",
        "    month,\n",
        "    member_months,\n",
        "    claim_count,\n",
        "    net_paid_amount,\n",
        "    pmpm_net_paid\n",
        "FROM claims_lakehouse_dev.gold.agg_payer_monthly\n",
        "WHERE member_months > 0\n",
        "ORDER BY payer_id, month\n"
      ]
    },
    {
      "name": "member_months",
      "displayName": "Member months by payer",
      "queryLines": [
        "-- Covered members per month, by payer (one member month = covered on any day of the month).\n",
        "SELECT\n",
        "    payer_id,\n",
        "    month,\n",
        "    count(*)                    AS member_months,\n",
        "    count(DISTINCT member_key)  AS members\n",
        "FROM claims_lakehouse_dev.gold.fct_member_months\n",
        "GROUP BY payer_id, month\n",
        "ORDER BY payer_id, month\n"
      ]
    },
    {
      "name": "switchers",
      "displayName": "Payer switchers",
      "queryLines": [
        "-- Members covered by more than one payer (for example, Medicare FFS to Medicare Advantage),\n",
        "-- with the payer covering them now. One row per person, keyed by MBI.\n",
        "SELECT\n",
        "    member_key,\n",
        "    payer_count,\n",
        "    coverage_span_count,\n",
        "    first_coverage_start_date,\n",
        "    current_payer_id,\n",
        "    current_coverage_start_date\n",
        "FROM claims_lakehouse_dev.gold.dim_member\n",
        "WHERE is_multi_payer\n",
        "ORDER BY member_key\n"
      ]
    },
    {
      "name": "claim_status",
      "displayName": "Claim status mix",
      "queryLines": [
        "-- Claims and net paid by conformed status, per payer. Payer codes (CANCELLED vs VOIDED) are\n",
        "-- mapped in each payer's conformed views, so the statuses compare across payers.\n",
        "SELECT\n",
        "    payer_id,\n",
        "    claim_status,\n",
        "    count(*)                AS claims,\n",
        "    sum(net_paid_amount)    AS net_paid_amount\n",
        "FROM claims_lakehouse_dev.gold.fct_claims\n",
        "GROUP BY payer_id, claim_status\n",
        "ORDER BY payer_id, claim_status\n"
      ]
    },
    {
      "name": "payers",
      "displayName": "Payer deliveries",
      "queryLines": [
        "-- Each payer from the registry: status, and the window of months it has delivered.\n",
        "SELECT\n",
        "    payer_id,\n",
        "    payer_name,\n",
        "    line_of_business,\n",
        "    payer_status,\n",
        "    first_delivery_month,\n",
        "    last_delivery_month,\n",
        "    current_file_count\n",
        "FROM claims_lakehouse_dev.gold.dim_payer\n",
        "ORDER BY payer_id\n"
      ]
    }
  ],
