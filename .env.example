# Copy to .env (git-ignored) and fill in. Never commit .env.
# Phase 1 (local tests) needs none of these.

# Azure (phase 2+). Read them from `az account show` if you prefer.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=

# Databricks workspace URL (phase 3+), e.g. https://adb-<id>.<n>.azuredatabricks.net
DATABRICKS_HOST=

# The archive container the bundle reads (phase 3+): terraform output archive_url
# e.g. abfss://archive@<storage account>.dfs.core.windows.net/
BUNDLE_VAR_archive_url=

# The service principal the pipelines and the job run as: terraform output runner_application_id
BUNDLE_VAR_runner_application_id=

# owner/name of the repository that receives notifier issues (phase 4).
# The GitHub credential itself lives in Key Vault, not here.
GITHUB_REPO=
