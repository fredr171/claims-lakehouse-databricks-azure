# Copy to terraform.tfvars (git-ignored) and fill in.
# The subscription is not set here: export ARM_SUBSCRIPTION_ID instead.

# 3-7 lowercase letters or digits; the same value you passed to bootstrap-state.ps1.
suffix = "abc12"

# Who the monthly budget emails (50% and 90% of actual spend, 100% forecast).
budget_alert_emails = ["you@example.com"]
